# Copy to .env and adjust. All values here have safe dev defaults in docker-compose.yml;
# .env is only needed to override them (e.g. for a real deployment).

POSTGRES_PASSWORD=zoneguard_dev_password
APP_SECRET_KEY=dev-only-change-me-in-prod
ENV=development
SEED_DEMO_DATA=true

# --- Auth: OIDC/SSO (recommended for any non-dev deployment) ---
# Leave all three blank to fall back to local username/password auth (dev only).
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Secrets backend: env | aws_secrets_manager ---
SECRETS_BACKEND=env
AWS_SECRETS_BUNDLE_ID=

# --- TLS scanning safety ---
# NEVER set true for credentialed calls; only for scan-target TLS verification, and only
# if you understand you're behind a corporate MITM proxy without REQUESTS_CA_BUNDLE set.
ALLOW_INSECURE_TLS_FALLBACK=false
ALLOW_RFC1918_SCAN_TARGETS=false
REQUESTS_CA_BUNDLE=

# --- Email digests ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=zoneguard@example.com
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Ticketing ---
JIRA_BASE_URL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
SERVICENOW_BASE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# --- DNSSEC over DoH ---
DOH_URL=https://cloudflare-dns.com/dns-query

CELERY_CONCURRENCY=4
